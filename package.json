{
  "name": "wasix-docs",
  "version": "0.1.0",
  "private": true,
  "description": "WASIX documentation site (wasix.org)",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path out/_pagefind",
    "preview": "wasmer run . --net -- --port 8080",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasix-org/wasix.org.git"
  },
  "license": "MIT",
  "dependencies": {
    "next": "^16.3.4",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-fast-marquee": "^1.6.5",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "zod": "~4.3.6"
    }
  }
}
